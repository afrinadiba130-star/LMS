@model UserTypeEditViewModel
@{
    ViewData["Title"] = "Edit User Type";
}

<h2>Edit @Model.TypeName</h2>

<form asp-action="Edit" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="TypeName" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="TypeName" class="form-label"></label>
            <input asp-for="TypeName" class="form-control" disabled />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="MaxBorrowLimit" class="form-label"></label>
            <input asp-for="MaxBorrowLimit" class="form-control" type="number" min="1" max="50" />
            <span asp-validation-for="MaxBorrowLimit" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="FineRatePerDay" class="form-label"></label>
            <input asp-for="FineRatePerDay" class="form-control" type="number" step="0.01" min="0" max="1000" />
            <span asp-validation-for="FineRatePerDay" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="MonthlyFee" class="form-label"></label>
            <input asp-for="MonthlyFee" class="form-control" type="number" step="0.01" min="0" max="100000" />
            <span asp-validation-for="MonthlyFee" class="text-danger"></span>
        </div>
        <div class="col-md-8 mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Rules</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}