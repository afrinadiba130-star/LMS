@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

@if (User.IsInRole("Admin"))
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Total Books</h6>
                    <h3 class="mb-0">@Model.TotalBooks <small class="fs-6">titles / @Model.TotalCopies copies</small></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Active Borrows</h6>
                    <h3 class="mb-0">@Model.ActiveBorrows</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Overdue Borrows</h6>
                    <h3 class="mb-0">@Model.OverdueBorrows</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-danger shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Unpaid Fines (BDT)</h6>
                    <h3 class="mb-0">Tk @Model.UnpaidFines.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Your membership: <strong>@User.Identity!.Name</strong> — you currently have
        <strong>@Model.MyActiveBorrows of @Model.MyBorrowLimit</strong> books borrowed.
    </div>
}

@if (!User.IsInRole("Admin"))
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white"><h5 class="mb-0">My Payments</h5></div>
        <div class="card-body p-0">
            @if (Model.MyPayments.Count == 0)
            {
                <p class="text-muted m-3 mb-0">No payments recorded yet.</p>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th><th>Type</th><th>Amount</th><th>TrxID</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.MyPayments)
                        {
                            <tr>
                                <td>@p.PaidDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    @if (p.PaymentType == WebApplication1.AppConstants.MembershipPayment)
                                    {
                                        <span class="badge text-bg-info">Membership</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Fine</span>
                                    }
                                </td>
                                <td><strong>Tk @p.Amount.ToString("N2")</strong></td>
                                <td class="small">@p.BkashTrxId</td>
                                <td class="text-end">
                                    <a asp-action="DownloadPaymentReceipt" asp-route-id="@p.PaymentId"
                                       class="btn btn-sm btn-outline-primary">Receipt</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">Recommended for You</h5></div>
            <div class="card-body">
                @if (Model.Recommendations.Count == 0)
                {
                    <p class="text-muted mb-0">Borrow a few books and we will tailor recommendations for you.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var rec in Model.Recommendations)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@rec.Title</strong>
                                    <div class="small text-muted">@rec.Author &middot; @rec.Genre</div>
                                    <span class="badge text-bg-light border">@rec.Reason</span>
                                </div>
                                <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-primary">View</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white"><h5 class="mb-0">Most Borrowed Books</h5></div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>#</th><th>Book</th><th>Genre</th><th>Borrows</th></tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.MostBorrowedBooks.Count; i++)
                            {
                                var b = Model.MostBorrowedBooks[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@b.Title <small class="text-muted d-block">@b.Author</small></td>
                                    <td>@b.Genre</td>
                                    <td><span class="badge text-bg-success">@b.BorrowCount</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (Model.MostBorrowedBooks.Count == 0)
                    {
                        <p class="text-muted m-3">No completed borrows yet.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (User.IsInRole("Admin"))
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-danger text-white"><h5 class="mb-0">Overdue Borrows</h5></div>
        <div class="card-body p-0">
            @if (Model.OverdueRecords.Count == 0)
            {
                <p class="text-muted m-3 mb-0">No overdue borrows. </p>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Book</th><th>Member</th><th>Borrowed</th><th>Due</th><th>Days Late</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.OverdueRecords)
                        {
                            var daysLate = (DateTime.Today - r.DueDate.Date).Days;
                            <tr>
                                <td>@r.Book.Title</td>
                                <td>@r.User.FullName</td>
                                <td>@r.BorrowDate.ToString("dd MMM yyyy")</td>
                                <td>@r.DueDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge text-bg-danger">@daysLate days</span></td>
                                <td><a asp-controller="Borrow" asp-action="Return" asp-route-id="@r.Id" class="btn btn-sm btn-danger">Return</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white"><h5 class="mb-0">Quick Actions</h5></div>
    <div class="card-body">
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary me-2">Browse Books</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Borrow" asp-action="Issue" class="btn btn-outline-success me-2">Issue a Book</a>
            <a asp-controller="Borrow" asp-action="Return" class="btn btn-outline-warning me-2">Return a Book</a>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-danger me-2">Download PDF Reports</a>
        }
    </div>
</div>