@model BookFormViewModel
@{
    ViewData["Title"] = "Add Book";
}

<h2>Add New Book</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ISBN" class="form-label"></label>
            <input asp-for="ISBN" class="form-control" />
            <span asp-validation-for="ISBN" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Genre" class="form-label"></label>
            <input asp-for="Genre" class="form-control" placeholder="e.g. Novel, Poetry, Science Fiction" />
            <span asp-validation-for="Genre" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Language" class="form-label"></label>
            <input asp-for="Language" class="form-control" placeholder="Bengali / English" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="TotalCopies" class="form-label"></label>
            <input asp-for="TotalCopies" class="form-control" type="number" min="1" />
            <span asp-validation-for="TotalCopies" class="text-danger"></span>
        </div>
        <div class="col-md-8 mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Book</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}