@model ReturnViewModel
@{
    ViewData["Title"] = "Return Book";
}

<h2>Return a Book</h2>
<p class="text-muted">Select a borrow record; any late-return fine will be calculated automatically in BDT.</p>

<form asp-action="Return" method="post" class="mt-3" id="returnForm">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="BorrowRecordId" class="form-label"></label>
            <select asp-for="BorrowRecordId" asp-items="Model.BorrowRecords" class="form-select" id="recordSelect">
                <option value="">-- Select active borrow --</option>
            </select>
            <span asp-validation-for="BorrowRecordId" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-warning">Confirm Return</button>
    <a asp-action="History" class="btn btn-outline-secondary">Cancel</a>
</form>

<div id="previewContainer" class="mt-4"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#recordSelect').on('change', function () {
            const id = $(this).val();
            const container = $('#previewContainer');
            if (!id) { container.empty(); return; }
            $.get('@Url.Action("PreviewReturn", "Borrow")', { id: id })
                .done(html => container.html(html))
                .fail(() => container.empty());
        });
    </script>
}