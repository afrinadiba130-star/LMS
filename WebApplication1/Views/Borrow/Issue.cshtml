@model BorrowIssueViewModel
@{
    ViewData["Title"] = "Issue Book";
}

<h2>Issue a Book</h2>
<p class="text-muted">Due date is automatically set to 14 days from today.</p>

@if (Model.Books.Count == 0)
{
    <div class="alert alert-warning">No books are currently available to issue.</div>
}

<form asp-action="Issue" method="post" class="mt-3">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="UserId" class="form-label"></label>
            <select asp-for="UserId" asp-items="Model.Users" class="form-select">
                <option value="">-- Select member --</option>
            </select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="BookId" class="form-label"></label>
            <select asp-for="BookId" asp-items="Model.Books" class="form-select">
                <option value="">-- Select book --</option>
            </select>
            <span asp-validation-for="BookId" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-success">Issue Book</button>
    <a asp-action="History" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}