@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var memberTypes = (List<WebApplication1.Models.Entities.UserType>)ViewBag.MemberTypes;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white"><h4 class="mb-0">Create your account</h4></div>
            <div class="card-body">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserTypeId" class="form-label"></label>
                        <select id="userTypeSelect" asp-for="UserTypeId" class="form-select">
                            <option value="">-- Select member type --</option>
                            @foreach (var t in memberTypes)
                            {
                                <option value="@t.Id" data-fee="@t.MonthlyFee">@t.TypeName — @t.MaxBorrowLimit books, fine Tk @t.FineRatePerDay/day, fee Tk @t.MonthlyFee/month</option>
                            }
                        </select>
                        <span asp-validation-for="UserTypeId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="alert alert-success border-2">
                        <h6 class="mb-2"><strong>&#9203; Membership Fee via bKash (Send Money)</strong></h6>
                        <ol class="mb-2 small">
                            <li>Open <strong>bKash</strong> app &rarr; <strong>Send Money</strong></li>
                            <li>Send to: <strong>01639459501</strong></li>
                            <li>Amount: <strong id="feeAmount">Tk --</strong></li>
                            <li>Enter the <strong>TrxID</strong> and your sender number below</li>
                        </ol>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label asp-for="BkashTrxId" class="form-label small mb-1 fw-bold"></label>
                                <input asp-for="BkashTrxId" class="form-control form-control-sm" placeholder="e.g. 9XK7H2M5A1" />
                                <span asp-validation-for="BkashTrxId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label asp-for="BkashSenderNumber" class="form-label small mb-1 fw-bold"></label>
                                <input asp-for="BkashSenderNumber" class="form-control form-control-sm" placeholder="e.g. 017XXXXXXXX" />
                                <span asp-validation-for="BkashSenderNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="small text-muted">Official bKash number: <strong>01639459501</strong></div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Pay &amp; Register</button>
                </form>
            </div>
        </div>
        <p class="mt-3 text-center">
            Already a member? <a asp-action="Login">Login here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#userTypeSelect').on('change', function () {
            const fee = $(this).find(':selected').data('fee');
            $('#feeAmount').text(fee ? 'Tk ' + fee.toLocaleString() + ' / month' : 'Tk --');
        });
    </script>
}